# FamilyFlow parent-web — copy to .env.local (never commit real secrets)

# Base URL of the FamilyFlow API (default shown)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3100

# LOCAL DEMO ONLY — development bearer token accepted by the local API when
# ALLOW_LOCAL_DEV_AUTH=true. Anything exposed via NEXT_PUBLIC_* is shipped to the
# browser, so this must NEVER hold a real credential. Replace with Cognito sign-in
# before any shared / production deployment.
NEXT_PUBLIC_LOCAL_PARENT_TOKEN=local:local-parent-001
