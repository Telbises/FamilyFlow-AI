{
  "name": "familyflow-ai",
  "private": true,
  "version": "0.1.0",
  "description": "FamilyFlow AI — Less scrolling. More living together. Amazon Devices Hackathon 2026.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @familyflow/domain test && pnpm --filter @familyflow/api test",
    "lint": "pnpm -r run lint --if-present",
    "typecheck": "pnpm -r run typecheck --if-present",
    "dev:api": "pnpm --filter @familyflow/api dev",
    "dev:web": "pnpm --filter @familyflow/parent-web dev",
    "dev:tv": "pnpm --filter @familyflow/fire-tv dev",
    "dev:mcp": "pnpm --filter @familyflow/alexa-plus-mcp start",
    "synth": "pnpm --filter @familyflow/infra synth",
    "openapi": "pnpm --filter @familyflow/api openapi",
    "verify:env": "bash scripts/verify-environment.sh",
    "test:all": "bash scripts/run-tests.sh",
    "test:e2e": "bash scripts/e2e-fire-tv-alexa.sh",
    "pack:release": "bash scripts/pack-release-zip.sh"
  },
  "license": "MIT"
}
