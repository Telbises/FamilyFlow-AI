# FamilyFlow local / deploy configuration
# Copy to .env and fill values. Never commit secrets.

# Runtime mode: local | aws
FAMILYFLOW_MODE=local
AWS_REGION=us-east-1
TABLE_NAME=FamilyFlow
IDEMPOTENCY_TABLE_NAME=FamilyFlowIdempotency

# Cognito (required for aws mode / production demo)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# API
API_BASE_URL=http://127.0.0.1:3100
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DynamoDB Local (local mode)
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Feature flags
FEATURE_VOICE=true
FEATURE_AI=true
FEATURE_REWARDS=true
FEATURE_DEVICE_PAIRING=true

# Bedrock (optional; curated library used when unavailable)
# Enable model access in AWS Bedrock console first — see docs/BEDROCK_SETUP.md
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_ENABLED=false

# Alexa+ MCP server (apps/alexa-plus-mcp)
MCP_PORT=3300
FAMILYFLOW_ACCESS_TOKEN=local:local-parent-001
FAMILYFLOW_API_BASE_URL=http://127.0.0.1:3100


# Local parent JWT bypass — DEVELOPMENT ONLY. Never enable for demo/prod.
# When set, Authorization: Bearer local:<ownerSub> is accepted.
ALLOW_LOCAL_DEV_AUTH=true
LOCAL_DEV_OWNER_SUB=local-parent-001

# Retention (days) disclosed in Settings
AUDIT_RETENTION_DAYS=365
REQUEST_RETENTION_DAYS=180
PAIRING_CODE_TTL_SECONDS=600
POINTS_PER_COMPLETION=10
